# KeeperHub self-hosted install settings.
#
#   cp .env.example .env      then fill in the REQUIRED section
#
# One file, read twice: once by the image build and once by install.sh. Fill it
# in before you build anything, because several values are compiled into the
# image and cannot be changed afterwards.
#
# QUOTE YOUR VALUES, as the examples do. The build reads this file with the
# shell, which strips quotes from what it reads, so an unquoted JSON value
# arrives with its own quotes missing and silently parses as empty.
#
# Never commit the .env you create. It is gitignored.

# ===========================================================================
# REQUIRED - the install will not work without these
# ===========================================================================

# Which cluster to install into. install.sh refuses to guess: a bare kubectl
# follows whatever context is current, and on a machine with production access
# that is how an install lands somewhere it should not.
#   kubectl config get-contexts
KUBE_CONTEXT=""

# A registry your cluster can pull from, and the repository inside it. Any OCI
# registry works. Every component lands here under its own tag prefix.
#
# There is no public KeeperHub image; you build your own. If the registry is
# private, your cluster also needs a pull secret, named per component with
# <component>.imagePullSecrets.
IMAGE_REPO="registry.yourcompany.com/keeperhub"

# The hostname the app is served on. Everything is derived from it: the ingress
# rule, the TLS certificate, and the URLs the app builds links from.
#
# Use a domain you control. Serve the app on a name this does not match and the
# UI loads and reads fine while every save returns 403.
APP_HOST="app.yourcompany.com"

# Your ingress controller's class. Any controller works; this only names it.
#   kubectl get ingressclass
INGRESS_CLASS=""

# A cert-manager ClusterIssuer, needed only if you want the chart to request
# certificates for you. Any CA behind it will do: a public ACME service, your
# own internal CA, or a self-signed issuer for a private domain.
#   kubectl get clusterissuer
#
# Terminating TLS somewhere else - a load balancer, a service mesh, an ingress
# controller holding its own certificate - is equally supported. Leave this
# empty and install with:
#   --set app.service.tls.enabled=false
TLS_ISSUER=""

# Mail. REQUIRED because signup sends a six-digit code: with no working relay,
# nobody can create an account and the install is unusable. Invitations,
# password resets and API-key creation use the same path.
#
# The app speaks SendGrid's v3 mail/send request shape. Any relay that accepts
# that shape works - point SENDGRID_API_URL at it below. That is a protocol
# requirement, not a vendor one; the variable is named for the shape, not for
# who you buy it from.
#
# The From address must be one the relay will accept as a sender, or sends are
# rejected.
SENDGRID_API_KEY=""
FROM_ADDRESS="noreply@yourcompany.com"

# ===========================================================================
# REQUIRED AT BUILD TIME - compiled into the image, and no Helm value changes
# them later. Getting one wrong means rebuilding.
#
# Every one may be left empty. Empty switches that feature off cleanly; wrong
# is what causes trouble.
# ===========================================================================

# Which sign-in buttons appear. Comma separated: email, github, google.
# A provider not listed here gets no button whatever keys you supply.
NEXT_PUBLIC_AUTH_PROVIDERS="email"

# The signup captcha. This is the one integration that is vendor specific: the
# app verifies against Cloudflare Turnstile and nothing else.
#
# The site key is compiled in; its partner TURNSTILE_SECRET_KEY below is read at
# runtime. Supplying one without the other gives a signup form that renders and
# then fails.
#
# To run without a captcha: leave both empty and set TURNSTILE_DISABLED=true.
NEXT_PUBLIC_TURNSTILE_SITE_KEY=""

# OAuth client ids, for social sign-in. Supported providers are GitHub and
# Google; leave both empty for email sign-in only. Secrets are runtime values,
# further down.
NEXT_PUBLIC_GITHUB_CLIENT_ID=""
NEXT_PUBLIC_GOOGLE_CLIENT_ID=""

# Error reporting, if you use a Sentry-compatible collector. Leave empty unless
# you want it: a DSN compiled into the image sends your users' browser errors to
# whoever owns that DSN, and the app proxies them through its own path, so the
# request leaves from your server rather than from the browser.
NEXT_PUBLIC_SENTRY_DSN=""

# ===========================================================================
# OPTIONAL - each one unlocks an area. Leave empty to leave it switched off.
# ===========================================================================

# --- Wallets and on-chain writes -------------------------------------------
# A wallet signing service. The app integrates with Turnkey; set
# TURNKEY_API_BASE_URL if you run your own Turnkey-compatible endpoint.
#
# Without it the pods still start and only wallet features fail: the Wallet
# overlay, every web3 write action, the protocol write actions and the Tempo
# steps.
TURNKEY_ORGANIZATION_ID=""
TURNKEY_API_PUBLIC_KEY=""
TURNKEY_API_PRIVATE_KEY=""

# --- Chain access ----------------------------------------------------------
# SET THIS BEFORE INSTALLING IF YOU SET IT AT ALL. Chain endpoints are written
# into the database when the migrator runs, so a value supplied afterwards
# leaves the websocket columns empty and the Block and Event triggers connect
# to nothing while every pod stays green.
#
# This is also the only way to configure a websocket endpoint. The per-chain
# CHAIN_<NAME>_PRIMARY_RPC variables are HTTP only.
#
# Reads work without it, on public endpoints seeded into your own database.
# A dedicated provider, or your own node, is what makes websockets reliable -
# public endpoints tend to drop long-lived connections.
#
# The keys are exact and a wrong one is ignored without warning. Ethereum's
# testnet is "eth-sepolia"; Base's is "base-testnet", not "base-sepolia".
#
# Example (one line). Substitute your own provider's endpoints, or your node's:
# CHAIN_RPC_CONFIG='{"eth-sepolia":{"chainId":11155111,"symbol":"ETH","primaryRpcUrl":"https://your-rpc-endpoint/","primaryWssUrl":"wss://your-rpc-endpoint/","isEnabled":true,"isTestnet":true}}'
CHAIN_RPC_CONFIG=""

# --- Captcha ---------------------------------------------------------------
# The runtime half of Turnstile. Set TURNSTILE_DISABLED=true instead to skip
# Cloudflare: your signup endpoint then accepts automated requests, and the
# server warns about it at every boot.
TURNSTILE_SECRET_KEY=""
TURNSTILE_DISABLED="true"

# --- OAuth secrets ---------------------------------------------------------
# The runtime partners of the client ids above. The provider is enabled by the
# plain id being present, so set both halves or neither.
GITHUB_CLIENT_ID=""
GITHUB_CLIENT_SECRET=""
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""

# --- Smaller things --------------------------------------------------------
# Contract ABI auto-fetch in the workflow editor, against an Etherscan-compatible
# explorer API. Per-chain explorer endpoints live in your own explorer_configs
# table, so you can point them wherever you like.
ETHERSCAN_API_KEY=""

# Portfolio enrichment for the wallet scanner. Without it /scan runs in
# native-only mode: it still works and shows less.
ZERION_API_KEY=""

# The mail endpoint, if it is not SendGrid's own. Any host accepting the v3
# mail/send shape.
SENDGRID_API_URL=""

# ===========================================================================
# INSTALL SHAPE - the defaults suit most installs
# ===========================================================================

NAMESPACE="keeperhub"

# PostgreSQL is REQUIRED. There is no third option: either the chart runs one
# for you, or you give it one you already run.
#
#   bundled  the chart creates and manages a PostgreSQL cluster, with failover
#            and backups. Needs the CloudNativePG operator installed
#            cluster-wide first. Credentials are generated for you.
#
#   byo      use your own database - managed, or your own server. Nothing to
#            install in the cluster. You MUST create the Secret below before
#            installing; the chart reads it and the install refuses to start
#            without it:
#
#              kubectl -n keeperhub create secret generic keeperhub-db \
#                --from-literal=DATABASE_URL='postgresql://user:pass@host:5432/keeperhub?sslmode=verify-full'
#
# Four things decide whether a bring-your-own database works, and each fails in
# a way that does not name itself. INSTALL.md explains them; in short:
#
#   1. PostgreSQL 13+, and the role you connect as must OWN the database. On
#      PG 15+ the public schema is not writable by a role that does not own it,
#      and the install fails at the first CREATE TABLE. No superuser needed and
#      no extensions are installed.
#   2. The URL MUST carry an explicit sslmode. Without one the driver connects
#      in plaintext, a TLS-requiring server refuses, and the install sits in
#      wait-for-db for five minutes before rolling the release back.
#   3. Size for connections, not data: about 45 at rest, about 85 with four
#      concurrent executions. Aim for max_connections >= 200. Small managed
#      tiers cap near 50-100 and fail only once several workflows run at once.
#   4. No transaction-mode connection pooler in front of it - that breaks the
#      LISTEN/NOTIFY the workflow engine depends on. Session mode is fine.
DB_MODE="bundled"

# Where the connection string lives. Under "bundled" the chart writes this
# Secret; under "byo" you create it and the chart only reads it. The defaults
# suit both, so change them only if the names clash with something you have.
DB_SECRET_NAME="keeperhub-db"
DB_SECRET_KEY="DATABASE_URL"

# Size of the chart-managed database. Ignored under "byo".
# Three instances gives failover; one suits an evaluation.
PG_INSTANCES=""
PG_STORAGE_SIZE=""

# A queue is REQUIRED too, and works the same way.
#
#   bundled  the chart runs one, nothing to install first
#   byo      any SQS-compatible endpoint you operate. Set both URLs below, and
#            AWS_ENDPOINT_URL as well unless it is real AWS SQS.
QUEUE_MODE="bundled"
SQS_QUEUE_URL=""
SQS_DLQ_URL=""
AWS_ENDPOINT_URL=""

# The Code step's execution sandbox. Without it every other step works and the
# Code step alone fails with a connection error.
SANDBOX_ENABLED="true"

# Which header your ingress controller sets to the real client address. Without it
# the app sees no address: signup throttling counts every caller in one shared bucket,
# so the whole install shares one signup allowance, and sessions record no address.
# ingress-nginx sets X-Real-IP. Name a header carrying a single value.
# Read INSTALL.md first if your cluster has no cloud load balancer - a single-replica
# controller replaces the client address with its own before any header is set.
CLIENT_IP_HEADERS="X-Real-IP"

# Addresses or CIDR ranges of your own proxies, comma-separated. Needed only when the
# header above carries more than one hop, e.g. a CDN in front of your ingress.
CLIENT_IP_TRUSTED_PROXIES=""

# Sent to third-party geo providers on every sign-in, and they need no
# credential, so configuring nothing is not the same as sending nothing.
GEOIP_ENABLED="false"

# Deny all outbound traffic except what the product needs. Leave false for the
# first install, confirm it works, then turn it on. It only takes effect if
# your CNI enforces NetworkPolicy, and the installer says which case you are in.
EGRESS_POLICY="false"

# Measure the policy instead of reporting what the cluster looks like. Two TCP
# connects from a pod that is already running: one to the API server, which must
# still work, and one to an address the policy denies, which must not. It
# creates nothing and it never fails the install. Worth turning on the first
# time you enable the policy on a cluster.
EGRESS_POLICY_VERIFY="false"

# IMAGE_TAG is deliberately absent. It identifies one build rather than one
# install, so it is passed on the command line:
#   ENV_FILE=.env IMAGE_TAG=v1 ./install.sh
