{
  "name": "keeperhub-scheduler",
  "version": "1.0.0",
  "private": true,
  "description": "KeeperHub scheduler components - schedule dispatcher and block dispatcher",
  "type": "module",
  "scripts": {
    "dispatcher": "tsx schedule-dispatcher/index.ts",
    "block-dispatcher": "tsx block-dispatcher/index.ts",
    "typecheck": "tsc --noEmit",
    "build": "tsc",
    "lint": "biome check .",
    "lint:fix": "biome check --write .",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:unit": "vitest run tests/unit"
  },
  "dependencies": {
    "@aws-sdk/client-sqs": "^3.1120.0",
    "@kubernetes/client-node": "^1.0.0",
    "cron-parser": "^5.10.0",
    "ethers": "^6.17.0",
    "express": "^4.22.2",
    "prom-client": "^15.1.3"
  },
  "devDependencies": {
    "@biomejs/biome": "^1.9.4",
    "@types/express": "^5.0.0",
    "@types/node": "^24.13.3",
    "@types/ws": "^8.18.1",
    "tsx": "^4.23.12",
    "typescript": "^5.9.3",
    "vite": "^8.2.2",
    "vitest": "4.1.11",
    "ws": "^8.21.3"
  },
  "pnpm": {
    "overrides": {
      "ws": ">=8.21.0",
      "vite": ">=8.0.16",
      "qs": "^6.16.0",
      "esbuild@>=0.27.3 <0.28.1": "^0.28.1",
      "body-parser@<2": "^1.20.6",
      "postcss": ">=8.5.18",
      "ip-address": "^10.3.1",
      "js-yaml": "^4.3.1",
      "nanoid@<3.3.17": "^3.3.17"
    }
  }
}
