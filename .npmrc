# Exclude packages needed by sandbox/ workspace from minimum-release-age gate
minimum-release-age-exclude[]=vitest
minimum-release-age-exclude[]=@vitest/expect
minimum-release-age-exclude[]=@vitest/runner
minimum-release-age-exclude[]=@vitest/mocker
minimum-release-age-exclude[]=@vitest/pretty-format
minimum-release-age-exclude[]=@vitest/snapshot
minimum-release-age-exclude[]=@vitest/spy
minimum-release-age-exclude[]=@vitest/utils
minimum-release-age-exclude[]=@types/node
minimum-release-age-exclude[]=typescript
minimum-release-age-exclude[]=@biomejs/biome
minimum-release-age-exclude[]=@biomejs/cli-darwin-arm64
minimum-release-age-exclude[]=@biomejs/cli-darwin-x64
minimum-release-age-exclude[]=@biomejs/cli-linux-arm64
minimum-release-age-exclude[]=@biomejs/cli-linux-arm64-musl
minimum-release-age-exclude[]=@biomejs/cli-linux-x64
minimum-release-age-exclude[]=@biomejs/cli-linux-x64-musl
minimum-release-age-exclude[]=@biomejs/cli-win32-arm64
minimum-release-age-exclude[]=@biomejs/cli-win32-x64
minimum-release-age-exclude[]=ultracite
minimum-release-age-exclude[]=monaco-editor
# Pure-JS QR matrix generator used for TOTP enrollment. Zero transitive
# deps, single-file library by kazuhikoarase (long-time maintainer).
# Pinned to 1.4.4 (2019); the policy exclusion is only because pnpm
# checks the latest published version of every package on resolve.
minimum-release-age-exclude[]=qrcode-generator
# Structural JSON diff used for the security audit log (who-changed-what).
# Pinned to 1.0.2 (2018); stable, zero transitive deps. The exclusion is
# only needed because pnpm checks the latest published version on resolve.
minimum-release-age-exclude[]=deep-diff
minimum-release-age-exclude[]=@types/deep-diff
# driver.js (MIT) is the onboarding-tour library; pnpm's release-age gate flags
# it on resolve, so exclude it so lockfile regeneration / fresh installs succeed.
minimum-release-age-exclude[]=driver.js
# bs58 is a direct dependency added for Solana transaction signature encoding
# (used in submit-signed-solana.ts). bs58@4 ships no types; base-x is its sole
# transitive dep. Both are excluded because pnpm resolves them against the
# latest published version to check release-age, not against the pinned lock.
minimum-release-age-exclude[]=bs58
minimum-release-age-exclude[]=base-x
# Sentry CLI and esbuild ship platform-specific optional packages. pnpm's release-age
# gate evaluates every variant when resolving the lock, even those not installed.
# These are excluded so fresh installs and lockfile regeneration do not fail.
minimum-release-age-exclude[]=@sentry/cli
minimum-release-age-exclude[]=@sentry/cli-linux-x64
minimum-release-age-exclude[]=@sentry/cli-linux-arm
minimum-release-age-exclude[]=@sentry/cli-linux-arm64
minimum-release-age-exclude[]=@sentry/cli-darwin-x64
minimum-release-age-exclude[]=@sentry/cli-darwin-arm64
minimum-release-age-exclude[]=@sentry/cli-win32-x64
minimum-release-age-exclude[]=@sentry/cli-win32-ia32
minimum-release-age-exclude[]=@sentry/cli-win32-arm64
minimum-release-age-exclude[]=@esbuild/aix-ppc64
minimum-release-age-exclude[]=@esbuild/linux-x64
minimum-release-age-exclude[]=@esbuild/linux-arm64
minimum-release-age-exclude[]=@esbuild/darwin-x64
minimum-release-age-exclude[]=@esbuild/darwin-arm64
minimum-release-age-exclude[]=@esbuild/win32-x64
minimum-release-age-exclude[]=@esbuild/win32-arm64
minimum-release-age-exclude[]=esbuild
minimum-release-age-exclude[]=fsevents
